#!/usr/bin/env bash
#
# Builds the site in strict mode to validate internal links and anchors.
# Additional arguments are passed to `zensical build`.

set -euo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

exec docker compose run --rm --build \
  zensical \
  zensical build --clean --strict "$@"
