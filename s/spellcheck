#!/usr/bin/env bash
#
# Runs codespell against the documentation and configuration in the shared
# Docker Compose environment. Optional arguments replace the default paths.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

DEFAULT_PATHS=(docs spec README.md SAFETY.md SECURITY.md agent-instructions.md AGENTS.md CLAUDE.md mkdocs.yml)

CONFIG_FILE_IN_CONTAINER=/app/.codespellrc
COMPOSE_FILE="$REPO_ROOT/docker-compose.yml"

if [ "$#" -gt 0 ]; then
  exec docker compose -f "$COMPOSE_FILE" --project-directory "$REPO_ROOT" run --rm --build zensical \
    codespell --config "$CONFIG_FILE_IN_CONTAINER" "$@"
else
  exec docker compose -f "$COMPOSE_FILE" --project-directory "$REPO_ROOT" run --rm --build zensical \
    codespell --config "$CONFIG_FILE_IN_CONTAINER" "${DEFAULT_PATHS[@]}"
fi
