#!/usr/bin/env bash
#
# Starts the Docker Compose documentation server and opens it in a browser once
# it is ready. Arguments are forwarded to `docker compose up`.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
COMPOSE_FILE="$REPO_ROOT/docker-compose.yml"

URL="http://localhost:8001/"

open_browser() {
	if [ -n "${BROWSER:-}" ]; then
		"${BROWSER}" "$URL" >/dev/null 2>&1 &
		return 0
	fi

	if command -v xdg-open >/dev/null 2>&1; then
		xdg-open "$URL" >/dev/null 2>&1 &
		return 0
	fi

	if command -v python >/dev/null 2>&1; then
		python -m webbrowser "$URL" >/dev/null 2>&1 &
		return 0
	fi

	return 1
}

wait_for_server() {
	# Wait up to ~30 seconds for the container port mapping to be reachable.
	for _ in $(seq 1 60); do
		if command -v curl >/dev/null 2>&1; then
			if curl -fsS "$URL" >/dev/null 2>&1; then
				return 0
			fi
		elif command -v python >/dev/null 2>&1; then
			if python - <<'PY'
import sys
import urllib.request

url = "http://localhost:8001/"
try:
		urllib.request.urlopen(url, timeout=1).read(1)
		sys.exit(0)
except Exception:
		sys.exit(1)
PY
			then
				return 0
			fi
		fi
		sleep 0.5
	done

	return 1
}

# Open the browser once the server is reachable.
( wait_for_server && open_browser ) &

exec docker compose -f "$COMPOSE_FILE" --project-directory "$REPO_ROOT" up "$@"
