#!/usr/bin/env bash
#
# Create a dated version tag for the documentation repo.
#
# Usage: s/version++ [major|minor|patch]
#
# This script:
# 1. Ensures you're on live with a clean working tree
# 2. Creates a release commit with today's date (YYYY.MM.DD format)
# 3. Handles multiple releases on the same day with suffixes (-a, -b, -c)
# 4. Pushes the commit to live; auto-tag.yml creates the tag and release
#
# The release commit triggers auto-tag.yml, which creates the tag and invokes
# the release workflow to build the PDF documentation.
#
# Arguments:
#   major, minor, patch - records significance in commit message
#   (defaults to minor for documentation updates)

set -euo pipefail

# CD to repo root
cd "$(git rev-parse --show-toplevel)"

# Default bump level
bump="${1:-minor}"

# Validate argument
case "$bump" in
  major|minor|patch) ;;
  -h|--help)
    echo "Usage: s/version++ [major|minor|patch]"
    echo ""
    echo "Creates a dated version tag for documentation releases."
    echo "Tag format: YYYY.MM.DD (e.g., 2026.07.05)"
    echo "Multiple releases on same day get suffixes: 2026.07.05-a, 2026.07.05-b"
    echo ""
    echo "Bump levels:"
    echo "  major - Breaking changes, major restructure"
    echo "  minor - New content, features (default)"
    echo "  patch - Small fixes, typos"
    exit 0
    ;;
  *)
    echo "Error: Unknown bump level '$bump'" >&2
    echo "Usage: s/version++ [major|minor|patch]" >&2
    exit 1
    ;;
esac

# Preflight: must be on main
if [[ "$(git branch --show-current)" != "live" ]]; then
  echo "Error: Must be on 'live' branch to create a release tag." >&2
  echo "Current branch: $(git branch --show-current)" >&2
  exit 1
fi

# Preflight: clean working tree
if [[ -n "$(git status --porcelain)" ]]; then
  echo "Error: Working tree is not clean." >&2
  echo "" >&2
  echo "Commit or stash your changes first:" >&2
  echo "  git status" >&2
  exit 1
fi

# Ensure the release starts from the shared live branch and includes tags created by CI.
git fetch --quiet --tags origin live
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse origin/live)" ]]; then
  echo "Error: Local 'live' must match 'origin/live' before creating a release." >&2
  echo "Update the branch and try again." >&2
  exit 1
fi

# Generate today's date in YYYY.MM.DD format
today=$(date +%Y.%m.%d)
base_tag="${today}"

# Check for existing tags today and determine suffix
suffixes=("" "-a" "-b" "-c" "-d" "-e" "-f" "-g" "-h" "-i" "-j")
tag_name=""

for try_suffix in "${suffixes[@]}"; do
  candidate="${base_tag}${try_suffix}"
  if ! git rev-parse --verify "refs/tags/v${candidate}" >/dev/null 2>&1; then
    tag_name="$candidate"
    break
  fi
done

if [[ -z "$tag_name" ]]; then
  echo "Error: Too many releases on same day (used all suffixes a-j)" >&2
  echo "Consider using a different approach for this release." >&2
  exit 1
fi

suffix="${tag_name#${base_tag}}"

# Create human-readable suffix description
if [[ -z "$suffix" ]]; then
  suffix_note=""
else
  suffix_note=" (${suffix#-} release)"
fi

# Create commit with bump level in message
commit_msg="docs(release): v${tag_name} (${bump})${suffix_note}"

echo "Creating release commit: ${commit_msg}"
git commit --allow-empty -m "${commit_msg}"

# Push the release commit. CI owns tag creation so there is one release path.
echo "Pushing to origin..."
git push origin live

echo ""
echo "Release commit for v${tag_name} pushed successfully"
echo "  Bump level: ${bump}${suffix_note}"
echo ""
echo "Next steps:"
echo "  - Monitor the release workflow: https://github.com/rcpch/digital-growth-charts-documentation/actions"
echo "  - Verify the tag after CI completes: git show v${tag_name}"
echo "  - View release: https://github.com/rcpch/digital-growth-charts-documentation/releases/tag/v${tag_name}"
