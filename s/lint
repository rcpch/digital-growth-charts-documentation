#!/usr/bin/env bash
#
# Runs PyMarkdown against the documentation and specifications in the shared
# Docker Compose environment. Optional arguments replace the default paths.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
COMPOSE_FILE="$REPO_ROOT/docker-compose.yml"
CONFIG_FILE_IN_CONTAINER=/app/.pymarkdown.yml

DEFAULT_PATHS=(docs spec README.md SAFETY.md SECURITY.md agent-instructions.md AGENTS.md CLAUDE.md)

if [ "$#" -gt 0 ]; then
  exec docker compose -f "$COMPOSE_FILE" --project-directory "$REPO_ROOT" run --rm --build zensical \
    pymarkdown --enable-extensions front-matter --config "$CONFIG_FILE_IN_CONTAINER" scan -r "$@"
else
  exec docker compose -f "$COMPOSE_FILE" --project-directory "$REPO_ROOT" run --rm --build zensical \
    pymarkdown --enable-extensions front-matter --config "$CONFIG_FILE_IN_CONTAINER" scan -r "${DEFAULT_PATHS[@]}"
fi
