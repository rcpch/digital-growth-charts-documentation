#!/usr/bin/env bash
#
# Stops the Docker Compose stack and removes its local images, but not volumes.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
COMPOSE_FILE="$REPO_ROOT/docker-compose.yml"

exec docker compose -f "$COMPOSE_FILE" --project-directory "$REPO_ROOT" down --rmi local "$@"
